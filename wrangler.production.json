{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordcraftapp",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://wordcraftapp.com",
    "VITE_APP_NAME": "WordCraftApp",
    "VITE_APP_DESCRIPTION": "WordCraftApp offers English WordCraft download guides, one-click online access, beginner tutorials, and a practical comparison with Microsoft Word.",
    "VITE_APP_LOGO": "/logo.svg",
    "VITE_DEFAULT_LOCALE": "en"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordcraftapp",
      "database_id": "2eadb4fa-1d68-4d04-baf8-e665f2e8ec1e",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "routes": [{ "pattern": "wordcraftapp.com", "custom_domain": true }]
}
